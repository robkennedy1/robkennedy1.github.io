---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

// Audio recaps: theatrical retellings of each session, narrated by Atlas.
//
// Episodes are derived from the sessions content collection, so titles, dates
// and blurbs stay in step with the write-ups automatically. To add an episode:
// drop public/audio/<slug>-recap.mp3 in place, add its running time below, and
// add the matching <item> to public/podcast.xml.
//
// A session with no MP3 on disk renders in a "coming soon" state with the
// player disabled — never point <audio> src at a file that doesn't exist.
//
// Base-aware links: import.meta.env.BASE_URL is '/' in production and
// '/robkennedy1.github.io/' on the fork's project-Pages staging preview.
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? base : base + href.slice(1));

// Running time is the one thing not derivable from the markdown.
const durations: Record<string, string> = {
  'session-01': '7:27',
  'session-02': '8:42',
  'session-03': '8:53',
  'session-04': '7:06',
};

const publicDir = fileURLToPath(new URL('../../public', import.meta.url));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const episodes = (await getCollection('sessions'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .map((entry) => {
    const audio = `/audio/${entry.slug}-recap.mp3`;
    return {
      n: entry.data.sessionNumber,
      slug: entry.slug,
      title: entry.data.title,
      date: fmt(entry.data.date),
      blurb: entry.data.blurb,
      duration: durations[entry.slug],
      audio: fs.existsSync(`${publicDir}${audio}`) ? audio : null,
    };
  });
---
<style>
  .recap-player {
    width: 100%;
    margin-top: 12px;
    display: block;
  }
  .recap-player:disabled {
    opacity: 0.55;
  }
  .coming-soon {
    display: inline-block;
    margin-top: 12px;
    padding: 3px 10px;
    border: 1px solid var(--accent-2);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-2);
  }
  .episode-duration {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .subscribe-card {
    margin-top: 32px;
  }
</style>
<Layout title="Audio Recaps" description="Theatrical audio recaps of every Out of the Abyss session, narrated by Atlas.">
  <p class="eyebrow">Podcast</p>
  <h1 class="page-title">Audio Recaps</h1>
  <p class="lead">
    Every session retold as a short theatrical audio episode. Listen here, or subscribe via the <a href={withBase('/podcast.xml')}>RSS feed</a> so they land in your podcast app as soon as they're released.
  </p>

  <div class="grid cols-2" style="margin-top:32px">
    {episodes.map((ep) => (
      <article class="card">
        <div class="body">
          <p class="meta">
            Session {ep.n} · {ep.date}
            {ep.duration && <> · <span class="episode-duration">{ep.duration}</span></>}
          </p>
          <h3>{ep.title}</h3>
          <p>{ep.blurb}</p>
          {ep.audio ? (
            <audio class="recap-player" controls preload="metadata" src={withBase(ep.audio)}>
              Your browser does not support the audio element.
            </audio>
          ) : (
            <>
              <span class="coming-soon">Episode in production</span>
              <audio class="recap-player" controls preload="none" disabled>
                Your browser does not support the audio element.
              </audio>
            </>
          )}
          <p class="meta" style="margin-top:8px">
            <a href={withBase(`/sessions/${ep.slug}`)}>Read the full session notes →</a>
          </p>
        </div>
      </article>
    ))}
  </div>

  <section class="card subscribe-card">
    <div class="body">
      <h3>Subscribe to the podcast</h3>
      <p>
        Paste <a href={withBase('/podcast.xml')}>https://robkennedy1.github.io/podcast.xml</a> into your podcast app's
        “Add podcast by URL / RSS” option and new recaps will arrive automatically.
      </p>
    </div>
  </section>

  <p class="meta" style="margin-top:32px">
    Music: “Oppressive Gloom”, “Dark Times” and “Lord of the Land” by Kevin MacLeod
    (incompetech.com), licensed under Creative Commons Attribution 4.0.
  </p>
</Layout>
